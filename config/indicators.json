{
  "_comment": "指標定義。scale 用於單位換算（FRED 的 OAS 是百分比，×100 換成 bps）。bands 由上而下比對，第一個吻合者勝出。derived 的表達式可引用其他指標 key，會在日期交集上逐日計算，因此衍生指標同樣有歷史與單日變動。",

  "tiers": [
    { "n": 1, "title": "TIER 1 — 資金水管 · 慢變數 · 落後但定義危機", "short": "資金水管",
      "plain": "銀行之間借錢順不順。這裡出事才叫「流動性危機」，但它反應最慢——真的亮燈時，事情已經很大了。" },
    { "n": 2, "title": "TIER 2 — 信用 · 中期領先 1–4 週 · 所有崩盤的領先指標", "short": "信用",
      "plain": "企業借錢要多付多少利息。歷史上所有崩盤都先在這裡出現裂縫，領先股市 1–4 週。" },
    { "n": 3, "title": "TIER 3 — 波動率 · 事件驅動 · 可於數小時內動作", "short": "波動率",
      "plain": "市場對「會不會出事」的定價。可以在幾小時內從平靜變恐慌，是最快的一層。" },
    { "n": 4, "title": "TIER 4 — 利率／匯率 · 市場流動性", "short": "利率／匯率",
      "plain": "長債殖利率與匯率。它決定所有資產的折現率——長端一動，高估值的股票最先被壓縮。" },
    { "n": 5, "title": "TIER 5 — 勞動／景氣 · 緩慢但確認", "short": "勞動",
      "plain": "就業與景氣。變化最慢，但它是「經濟真的在轉弱嗎」的最終確認。" }
  ],

