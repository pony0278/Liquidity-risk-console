          "default_state": "live"
        },
        {
          "step": "02",
          "label": "長端殖利率跳升",
          "cond": "觸發條件：30Y > 5.0% 或 2s30s > 80bps",
          "expr": "y30 > 5.0 or slope_2s30s > 80",
          "jump": "g-y30"
        },
        {
          "step": "03",
          "label": "高倍數股估值壓縮",
          "cond": "觸發條件：Nasdaq 100 自 60 日高點回落 > 5%",
          "expr": "ndx_dd60 <= -5",
          "jump": "g-y10"
        },
        {
          "step": "04",
          "label": "企業再融資成本上升",
          "cond": "觸發條件：HY OAS > 350bps",
          "expr": "hy_oas > 350",
          "jump": "g-hy_oas"
        },
        {
          "step": "05",
          "label": "槓桿長債部位追繳",
          "cond": "觸發條件：MOVE > 130 或 SRF > $20B",
          "expr": "move > 130 or srf > 20",
          "jump": "g-move"
        },
        {
          "step": "06 質變",
          "label": "資金水管斷裂",
          "cond": "觸發條件：SOFR−IORB 由負轉正",
